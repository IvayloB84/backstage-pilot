# 📦 Block JavaScript dependency trees from cloning into build context
node_modules
packages/*/node_modules
plugins/*/node_modules

# 🏗️ Block generic output folders
dist
packages/app/dist
plugins/*/dist

# 🚨 CRITICAL EXCEPTIONS: Do NOT ignore the compiled production bundles!
packages/backend/dist/*
!packages/backend/dist/skeleton.tar.gz
!packages/backend/dist/bundle.tar.gz

# 🧾 Block lockfiles, git history records, environments, and logs
.git
.github
*.log
.env
.yarn/cache
.yarn/install-state.gz
