# Block JavaScript dependency trees from cloning into build context
node_modules
packages/*/node_modules
plugins/*/node_modules

# Block generic output folders
dist
packages/app/dist
plugins/*/dist

# Exception handling for backend production bundles
packages/backend/dist/*
!packages/backend/dist/skeleton.tar.gz
!packages/backend/dist/bundle.tar.gz

# Yarn 4 Modern Cache & State tracking
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Local configuration overrides (Security Best Practice)
app-config.local.yaml
app-config.production.yaml
developer.yaml

# System records, source control, and logs
.git
.github
.vscode
*.log
.env